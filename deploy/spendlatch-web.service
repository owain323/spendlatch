[Unit]
Description=SpendLatch web app and chat API (FastAPI, loopback only)
After=network.target

[Service]
Type=simple
# The service account predates the rename and is still `spendpilot`.
# Renaming a Linux account means re-owning data/, stopping both units and
# a usermod under load; it is deliberately not done here, and the account
# name is the only surviving use of the old spelling.
User=spendpilot
Group=spendpilot
WorkingDirectory=/opt/spendlatch
Environment=SPENDLATCH_WEB_PORT=8201
ExecStart=/opt/spendlatch/.venv/bin/python -m agent.backend
Restart=on-failure
RestartSec=3

# The app only needs to write its state file under data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/spendlatch/data

[Install]
WantedBy=multi-user.target
